# WealthNX Apache Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0a. Collapse duplicate leading slashes (e.g. //?adj_t=...) → single 301 to canonical host
    RewriteCond %{REQUEST_URI} ^//+
    RewriteCond %{REQUEST_URI} ^/+(.*)$
    RewriteRule ^ https://www.wealthnx.ai/%1 [R=301,L]

    # 0b. Canonical host: force HTTPS + www in one 301 hop → https://www.wealthnx.ai/…
    RewriteCond %{HTTP_HOST} !^www\.wealthnx\.ai$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://www.wealthnx.ai%{REQUEST_URI} [R=301,L]

    # 0c. The old WordPress blog (/blog/...) was removed: send every old URL to the new /blogs/ page.
    #     (Placed before the file/dir skips so a leftover blog/ folder on the server can never shadow it.)
    # >>> wordpress-blog-redirects (generated by scripts/blog-import/build.mjs; do not edit by hand)
    # Old WordPress blog (/blog/...) -> new blog (/blogs/...). One 301 per post, then catch-alls.
    # The WordPress back end stays reachable while WordPress is still installed under /blog/; remove this line when it is retired.
    RewriteRule ^blog/(wp-admin|wp-login\.php|wp-json|wp-content|wp-includes|wp-cron\.php|xmlrpc\.php)(/|$) - [L]
    RewriteRule ^blog/cloud-computing-enables-flexible-cost-data-storage-solutions/?$ /blogs/cloud-computing-enables-flexible-cost-data-storage-solutions/ [R=301,L]
    RewriteRule ^blog/automated-financial-systems-how-ai-executes-rules-for-saving-investing-and-debt-allocation/?$ /blogs/automated-financial-systems-how-ai-executes-rules-for-saving-investing-and-debt-allocation/ [R=301,L]
    RewriteRule ^blog/how-ai-learns-your-spending-patterns-without-storing-personal-details/?$ /blogs/how-ai-learns-your-spending-patterns-without-storing-personal-details/ [R=301,L]
    RewriteRule ^blog/how-ai-categorizes-and-enriches-financial-data/?$ /blogs/how-ai-categorizes-and-enriches-financial-data/ [R=301,L]
    RewriteRule ^blog/major-tournaments-unite-fans-from-different-countries-and-cultures/?$ /blogs/major-tournaments-unite-fans-from-different-countries-and-cultures/ [R=301,L]
    RewriteRule ^blog/web-development-shapes-how-users-interact-with-online-content/?$ /blogs/web-development-shapes-how-users-interact-with-online-content/ [R=301,L]
    RewriteRule ^blog/continuous-learning-keeps-web-developers-ahead-in-evolving-technology/?$ /blogs/continuous-learning-keeps-web-developers-ahead-in-evolving-technology/ [R=301,L]
    RewriteRule ^blog/behind-the-scenes-of-real-time-transaction-alerts-how-ai-detects-signals-in-seconds/?$ /blogs/behind-the-scenes-of-real-time-transaction-alerts-how-ai-detects-signals-in-seconds/ [R=301,L]
    RewriteRule ^blog/ai-powered-recurring-expense-tracking-how-apps-identify-subscriptions-automatically/?$ /blogs/ai-powered-recurring-expense-tracking-how-apps-identify-subscriptions-automatically/ [R=301,L]
    RewriteRule ^blog/ai-driven-goal-tracking-turning-long-term-intentions-into-actionable-milestones/?$ /blogs/ai-driven-goal-tracking-turning-long-term-intentions-into-actionable-milestones/ [R=301,L]
