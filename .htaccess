    # listing pages, categories, authors, tags, feeds and anything else under /blog/
    RewriteRule ^blog(/.*)?$ /blogs/ [R=301,L]
    # <<< wordpress-blog-redirects

    # 0d. Feature pages that moved: send old URLs to the new canonical in one 301 hop.
    RewriteRule ^features/voice-to-voice/?$ /wealth-genie/voice-to-voice/ [R=301,L]
    RewriteRule ^features/(?:voice-and-action|voice-to-action)/?$ /wealth-genie/voice-to-action/ [R=301,L]
    RewriteRule ^features/(?:proactive-ai|ai-insights)/?$ /wealth-genie/ai-insights/ [R=301,L]
    #     (Trailing "?" on the target drops the old ?feature= query string.)
    RewriteRule ^features/bills/transactions/?$ /features/transactions/ [R=301,L]
    RewriteRule ^features/side-hustle-tracker/?$ /features/business-expense-tracking/ [R=301,L]
    RewriteRule ^features/business/?$ /features/business-expense-tracking/ [R=301,L]
    RewriteRule ^features/budgeting/family-budget/?$ /features/members/ [R=301,L]
    RewriteRule ^features/budgets/?$ /features/budgeting/ [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)feature=Budgets(&|$)
    RewriteRule ^features/?$ /features/budgeting/? [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)feature=Bills(&|$)
    RewriteRule ^features/?$ /features/bills/? [R=301,L]
    RewriteRule ^features/subscriptions/?$ /features/subscription-tracker/ [R=301,L]
    RewriteRule ^recurring-expense-tracker/?$ /features/subscription-tracker/ [R=301,L]
    RewriteRule ^money-leaks/?$ /features/subscription-tracker/ [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)feature=Goals(&|$)
    RewriteRule ^features/?$ /features/goals/? [R=301,L]
    RewriteRule ^features/budgeting/forecasting/?$ /features/financial-forecasting/ [R=301,L]
    RewriteRule ^features/forecasting/?$ /features/financial-forecasting/ [R=301,L]
    RewriteRule ^features/savings-rate/?$ /features/savings-rate-calculator/ [R=301,L]
    RewriteRule ^features/period-comparison/?$ /features/compare-spending/ [R=301,L]
    RewriteRule ^features/exposure-analysis/?$ /features/portfolio-exposure-analysis/ [R=301,L]
    RewriteRule ^features/dividend-tracking/?$ /features/dividend-tracker/ [R=301,L]
    RewriteRule ^features/benchmark-comparison/?$ /features/portfolio-benchmark-comparison/ [R=301,L]
    RewriteRule ^features/decision-analysis/?$ /features/investment-decision-analysis/ [R=301,L]
    RewriteRule ^features/gain-and-loss-analysis/?$ /features/portfolio-performance-tracker/ [R=301,L]
    RewriteRule ^features/celebrities-portfolio-tracking/?$ /features/celebrity-portfolio-tracking/ [R=301,L]
    RewriteRule ^features/watchlist/?$ /features/stock-watchlist/ [R=301,L]
    RewriteRule ^features/news-sentiment-analysis/?$ /features/stock-news-sentiment/ [R=301,L]
    RewriteRule ^features/insider-trades/?$ /features/insider-trading-data/ [R=301,L]
    RewriteRule ^net-worth-tracker/?$ /features/net-worth/ [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)feature=Net(%20|+| )Worth(&|$) [NC]
    RewriteRule ^features/?$ /features/net-worth/? [R=301,L]
    RewriteRule ^features/budgeting/cash-flow-tracker/?$ /features/cash-flow/ [R=301,L]
    RewriteRule ^features/merchants/?$ /features/spending-by-merchant/ [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)feature=Transactions(&|$)
    RewriteRule ^features/?$ /features/transactions/? [R=301,L]

    # 1. SKIP all rewrites for existing files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. SKIP all rewrites for existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Route /api/* to api.php
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

    # 4a. Blog sitemap (every published post, generated from the database).
    RewriteRule ^sitemap-blog\.xml$ blog-sitemap.php [L]

    # 4b. Blog post URLs: /blogs/<slug>/ goes through blog-post.php, which writes the post's real
    #     title / description / canonical / JSON-LD and a server-rendered copy of the article into the
    #     static reader shell (blogs/read/index.html); the shell then loads the post from /api/blog/post.
    #     /blogs/ and /blogs/read/ are real directories and were already skipped by rule 2.
    RewriteCond %{REQUEST_URI} ^/blogs/[A-Za-z0-9_-]+/?$
    RewriteCond %{REQUEST_URI} !^/blogs/read/?$
    RewriteRule ^blogs/([A-Za-z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # 5. Route everything else to index.html — exclude all static asset paths
    RewriteCond %{REQUEST_URI} !^/_next/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteCond %{REQUEST_URI} !^/dist/
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !\.(?:css|js|svg|svgz|png|jpg|jpeg|gif|ico|webp|mp4|webm|woff|woff2|ttf|eot|json|txt|xml|pdf)$ [NC]
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# MIME types — must include SVG or browsers refuse to render them
<IfModule mod_mime.c>
    AddType application/javascript         js mjs
    AddType text/css                       css
    AddType application/json              json
    AddType image/svg+xml                 svg svgz
    AddType image/webp                    webp
    AddType video/mp4                     mp4
    AddType video/webm                    webm
    AddType font/woff                     woff
    AddType font/woff2                    woff2
    AddType application/vnd.ms-fontobject eot
    AddType font/ttf                      ttf
    AddEncoding gzip                      svgz
</IfModule>

# Compression — speeds up load time significantly
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# Browser caching — static assets cached aggressively
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                         "access plus 1 week"
    ExpiresByType text/html                "access plus 0 seconds"
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/jpg                "access plus 1 year"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/gif                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType video/mp4                "access plus 1 year"
    ExpiresByType video/webm               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

# Security + CORS for fonts/assets
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://link.msgsndr.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-src https://www.youtube.com https://api.leadconnectorhq.com;"
    # Admin panel must never be indexed
    <If "%{REQUEST_URI} =~ m#^/admin(/|$)#">
        Header set X-Robots-Tag "noindex, nofollow"
    </If>
    # Allow fonts and assets to load cross-origin
    <FilesMatch "\.(svg|svgz|woff|woff2|ttf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
